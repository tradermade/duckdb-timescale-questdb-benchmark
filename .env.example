# Copy to .env and edit. Never commit your real .env.

# Only needed if you download your OWN data with scripts/download_tradermade.py.
# Get a free key at https://tradermade.com/signup
TRADERMADE_API_KEY=

# Connection strings (defaults match docker-compose.yml).
TIMESCALE_DSN=postgresql://bench:bench@localhost:5432/market
QUESTDB_HTTP=http://localhost:9000
DUCKDB_PATH=market.duckdb

# Which parquet file(s) to load (glob). Defaults to the bundled 2-week sample.
DATA_GLOB=data/*.parquet
